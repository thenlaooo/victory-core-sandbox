  "item": [
    {
      "name": "01. Нечеткий поиск бойца",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус ответа 200 OK\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Найдена хотя бы одна запись\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.total_found).to.be.above(0);\n    pm.expect(jsonData.results).to.be.an(\"array\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Ивонов Иван 1943 Крупышино\",\n  \"threshold\": 50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/search/soldier",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "search",
            "soldier"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02. Получение задания квеста",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Квест получен успешно (200 OK)\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Наличие зашифрованной радиограммы\", function () {\n    const data = pm.response.json();\n    pm.expect(data).to.have.property(\"encrypted_dispatch\");\n    pm.expect(data.point_id).to.eql(1);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/quest/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "quest",
            "1"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03. Валидация ответа ребенка",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Ответ принят бэкендом (200 OK)\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Нечеткий валидатор простил опечатку\", function () {\n    const res = pm.response.json();\n    pm.expect(res.success).to.be.true;\n    pm.expect(res.score).to.be.above(80.0);\n    pm.expect(res).to.have.property(\"bonus_points\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
